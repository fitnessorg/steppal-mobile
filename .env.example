# Copy to .env. Expo only exposes variables prefixed EXPO_PUBLIC_ to the app.

# Leave this UNSET to run the app in demo mode: mock data, no network, nothing
# to install. That is how the app runs from a fresh clone, and how the demo
# video gets the same numbers on every take.
#
# Set it to a running steppal-core to get real sign-in, pots and step sync.
# An Android emulator reaches your machine's localhost at 10.0.2.2; a phone on
# the same wifi needs your machine's LAN address.
#
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Forces sample steps even on a device that could read real ones. Useful when
# recording, where repeatable numbers matter more than true ones.
# EXPO_PUBLIC_STEP_SOURCE=mock
